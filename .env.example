# Copy to .env and fill in your keys:  copy .env.example .env
#
# .env is gitignored. This template lists every variable the system reads.
# All three services have a free tier that does not ask for a card.


# ---------------------------------------------------------------------------
# Language model
# ---------------------------------------------------------------------------
# Handles conversation, qualification, objections and live signal extraction.
# Key from https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Speaks during a call. Picked on first-token latency, not capability - much
# over a second of silence and the bot feels broken. Numbers from
# scripts/benchmark_language_models.py.
GEMINI_MODEL=gemini-3.1-flash-lite

# Off the call path, where a few seconds cost nothing: summaries, batch work.
GEMINI_DEEP_MODEL=gemini-3.5-flash

# These models deliberate by default, which roughly triples the wait before the
# first word. Off for live replies. -1 restores the model's own default.
GEMINI_THINKING_BUDGET=0


# ---------------------------------------------------------------------------
# Speech to text
# ---------------------------------------------------------------------------
# Whisper, for per-utterance transcription. Strongest coverage of the Tagalog
# and Indonesian audio. Key from https://console.groq.com/keys
GROQ_API_KEY=
GROQ_ASR_MODEL=whisper-large-v3-turbo

# Spare conversation model when Gemini throttles, so a rate limit interrupts a
# call rather than ending it.
GROQ_LLM_MODEL=llama-3.3-70b-versatile

# Continuous streaming transcription with speaker separation, which is what the
# live nudge pipeline listens to. Key from https://console.deepgram.com
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-2


# ---------------------------------------------------------------------------
# Text to speech
# ---------------------------------------------------------------------------
# No key needed. Native voices per market, not an English voice reading foreign
# words.
TTS_VOICE_EN=en-US-AriaNeural
TTS_VOICE_FIL=fil-PH-BlessicaNeural
TTS_VOICE_ID=id-ID-GadisNeural


# ---------------------------------------------------------------------------
# Retrieval
# ---------------------------------------------------------------------------
# Hosted, because the small local models don't cover Tagalog: the best scored
# -0.02 between a Tagalog question and its own English translation, rating an
# unrelated sentence higher. Hosted scores +0.90 on the same pair. Reproduce
# with scripts/benchmark_embeddings.py.
#
# Costs ~500 ms per query. Keyword search runs alongside it so that wait
# overlaps rather than adds.
EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMS=768

# Used when EMBEDDING_PROVIDER=local, and if hosted is unreachable. ~7 ms and
# offline, but only English and Indonesian can be trusted on it.
EMBEDDING_LOCAL_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# Below MIN_SCORE the agent says it doesn't know rather than answering from a
# weak match. This is the main defence against invented answers.
RETRIEVAL_TOP_K=5
RETRIEVAL_MIN_SCORE=0.35


# ---------------------------------------------------------------------------
# Live nudges
# ---------------------------------------------------------------------------
# Thresholds that stop the dashboard filling with low value alerts, which is
# worse than staying quiet.
NUDGE_MIN_CONFIDENCE=0.6
NUDGE_COOLDOWN_SECONDS=45
NUDGE_EXPIRY_SECONDS=120

# Transcription window. Shorter lowers latency but gives less context to judge
# intent from.
AUDIO_CHUNK_MS=500


# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
APP_HOST=127.0.0.1
APP_PORT=8000
LOG_LEVEL=INFO

# Where a qualified lead or escalation is posted. Blank logs it locally instead.
ESCALATION_WEBHOOK_URL=


# ---------------------------------------------------------------------------
# Local paths
# ---------------------------------------------------------------------------
# Models live beside the project, not in the user profile, to keep them off the
# system drive.
MODEL_CACHE_DIR=.cache/models
HF_HOME=.cache/models
HF_HUB_DISABLE_SYMLINKS_WARNING=1
