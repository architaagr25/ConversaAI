# Copy this file to .env and fill in your own keys.
#
#   copy .env.example .env
#
# .env is ignored by git and must never be committed. This file is the tracked
# template: it lists every variable the system reads, with no real values in it.
#
# All three services below have a free tier that does not ask for a card.


# ---------------------------------------------------------------------------
# Language model
# ---------------------------------------------------------------------------
# Gemini handles every conversation: qualification logic, objection handling,
# localized dialogue, and the signal extraction behind live nudges.
# Key from https://aistudio.google.com/apikey
GEMINI_API_KEY=

# The model that speaks during a call. Chosen on measured first-token latency
# rather than raw capability, because anything above roughly a second of silence
# after the caller stops talking is audible and makes the bot feel broken.
# See scripts/benchmark_language_models.py for the numbers behind this.
GEMINI_MODEL=gemini-3.1-flash-lite

# Used off the call path, where a few seconds do not matter: end-of-call
# summaries, batch analysis, and anything needing more careful reasoning.
GEMINI_DEEP_MODEL=gemini-3.5-flash

# Newer models deliberate before answering by default, which roughly triples
# the wait before the first word. That is worth paying for in a hard judgement
# and wasteful in a scripted phone turn, so it is switched off for live replies.
# Set to -1 to restore the model's own default.
GEMINI_THINKING_BUDGET=0


# ---------------------------------------------------------------------------
# Speech to text
# ---------------------------------------------------------------------------
# Groq runs Whisper, used for per-utterance transcription during a call and for
# the Tagalog and Indonesian audio where its language coverage is strongest.
# Key from https://console.groq.com/keys
GROQ_API_KEY=
GROQ_ASR_MODEL=whisper-large-v3-turbo

# Groq also serves as a spare conversation model if Gemini is rate limited, so
# a throttled key interrupts a call rather than ending it.
GROQ_LLM_MODEL=llama-3.3-70b-versatile

# Deepgram handles continuous streaming transcription with speaker separation,
# which is what the live nudge pipeline listens to.
# Key from https://console.deepgram.com
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-2


# ---------------------------------------------------------------------------
# Text to speech
# ---------------------------------------------------------------------------
# Speech synthesis needs no key. These are the voices used per market; each is
# a native voice for its language rather than an English voice reading foreign
# words.
TTS_VOICE_EN=en-US-AriaNeural
TTS_VOICE_FIL=fil-PH-BlessicaNeural
TTS_VOICE_ID=id-ID-GadisNeural


# ---------------------------------------------------------------------------
# Retrieval
# ---------------------------------------------------------------------------
# Retrieval depends on a Tagalog or Indonesian question landing near its English
# answer. The small local models that fit comfortably on a laptop do not manage
# this: the best of them scored -0.02 between a Tagalog question and its own
# English translation, which is indistinguishable from noise, while rating an
# unrelated sentence higher. The hosted model scores +0.90 on the same pair.
# Numbers are reproducible with scripts/benchmark_embeddings.py.
#
# The cost is a network round trip of roughly half a second per query. Keyword
# search runs in parallel and returns immediately, so that wait overlaps with
# useful work rather than being added to it.
EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMS=768

# Used when EMBEDDING_PROVIDER is set to local, and automatically if the hosted
# service cannot be reached. Runs offline in about 7 ms, but only English and
# Indonesian retrieval can be trusted on it.
EMBEDDING_LOCAL_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# How many records retrieval returns, and how similar a record must be before
# it is allowed to support an answer. Below the floor the agent says it does
# not know instead of answering from a weak match.
RETRIEVAL_TOP_K=5
RETRIEVAL_MIN_SCORE=0.35


# ---------------------------------------------------------------------------
# Live nudges
# ---------------------------------------------------------------------------
# How confident a detected signal must be before it reaches the agent, and how
# long to wait before repeating a nudge on the same topic. These exist to stop
# the dashboard filling with low value alerts, which is worse than staying quiet.
NUDGE_MIN_CONFIDENCE=0.6
NUDGE_COOLDOWN_SECONDS=45
NUDGE_EXPIRY_SECONDS=120

# Audio is transcribed in windows of this length. Shorter windows lower latency
# but give the model less context to judge intent from.
AUDIO_CHUNK_MS=500


# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
APP_HOST=127.0.0.1
APP_PORT=8000
LOG_LEVEL=INFO

# Where a qualified lead or an escalation request is posted. Leave blank to log
# the payload locally instead of sending it anywhere.
ESCALATION_WEBHOOK_URL=


# ---------------------------------------------------------------------------
# Local paths
# ---------------------------------------------------------------------------
# Model files are kept beside the project rather than in the user profile, so
# they do not consume space on the system drive.
MODEL_CACHE_DIR=.cache/models
HF_HOME=.cache/models
HF_HUB_DISABLE_SYMLINKS_WARNING=1
