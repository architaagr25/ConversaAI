# Secrets and local configuration
# .env holds real API keys and must never leave this machine.
# .env.example is the tracked template and is explicitly re-included below.
.env
.env.*
!.env.example
*.key
*.pem
secrets/
keys.txt
*secret*
*credential*
*apikey*
*api_key*

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/

# Virtual environment
.venv/
venv/
env/

# Test and lint caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Downloaded model files and package caches.
# These are redirected here so they never fill the system drive, and they are
# regenerated automatically on first run.
.cache/
models/
*.onnx

# Generated retrieval index.
# The source records are tracked; the vector index is rebuilt from them in
# seconds, so there is no reason to carry binary blobs in version control.
data/kb/*.npy
data/kb/*.faiss
data/kb/*.index

# Working copies of leads, which keep the caller's contact details.
# The redacted copies in results/leads are the ones meant to be shared.
data/leads/

# Runtime logs and scratch files
logs/
*.log
tmp/
scratch/

# Editor and OS noise.
# The workspace settings are kept because they point the editor at the project's
# own interpreter; without that, imports resolve against whatever Python happens
# to be on PATH and the editor reports errors that do not exist.
.vscode/*
!.vscode/settings.json
.idea/
*.swp
Thumbs.db
desktop.ini
$RECYCLE.BIN/
